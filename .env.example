# Local development only. Copy to .env (gitignored) - never commit real values.
# These mirror the Lambda environment variables set by template.yaml.

STATE_BUCKET=inkpath-state-000000000000-us-east-1
GITHUB_REPO=your-user/your-private-vault
GITHUB_BRANCH=main
VAULT_NOTE_PATH=Inbox/reMarkable

WATCH_FOLDER=YourReadingFolder
# WATCH_FOLDER_ID=            # preferred if you have duplicate folder names
# INCLUDE_NOTEBOOKS=Book A,Book B
# EXCLUDE_NOTEBOOKS=Scratch

AI_PROVIDER=bedrock
AI_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

BATCH_MODE=none
MAX_PAGES_PER_RUN=20
RENDER_WIDTH=1400
BLANK_PAGE_THRESHOLD=3
MIN_TEXT_LENGTH=20
DRY_RUN=true

# Secrets are NEVER read from here - they come from SSM SecureString:
#   /rmsync/remarkable-token
#   /rmsync/github-pat
#   /rmsync/ai-api-key      (only when AI_PROVIDER=direct)
